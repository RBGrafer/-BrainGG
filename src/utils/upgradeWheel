/**
 * Geometry helpers for the upgrade roulette.
 * The conic-gradient green sector starts at 12 o'clock and grows clockwise.
 * The pointer orbit is animated in CSS; this helper returns the exact final sector angle.
 */
export function normalizeUpgradeChance(value, fallback = 0.1) {
  const parsed = Number(value);
  const fallbackValue = Number(fallback);
  const safeValue = Number.isFinite(parsed)
    ? parsed
    : Number.isFinite(fallbackValue)
      ? fallbackValue
      : 0.1;

  return Math.min(90, Math.max(0.1, safeValue));
}

export function getUpgradeSectorCenter(won, chancePercent) {
  const chance = normalizeUpgradeChance(chancePercent);
  const greenSweep = chance * 3.6;

  if (won) return greenSweep / 2;

  // The losing sector is the clockwise arc immediately after the green arc.
  return greenSweep + (360 - greenSweep) / 2;
}
