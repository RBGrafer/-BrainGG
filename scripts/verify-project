import assert from 'node:assert/strict';
import { readFileSync, existsSync } from 'node:fs';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import path from 'node:path';

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const read = (relative) => readFileSync(path.join(root, relative), 'utf8');
const backend = read('supabase/functions/braingg-api/index.ts');
const cases = read('src/data/cases.js');
const sql = read('supabase/manual-sql/special-case-credits.sql');
const config = read('supabase/config.toml');
const packageJson = JSON.parse(read('package.json'));

assert.match(config, /\[functions\.braingg-api\][\s\S]*?verify_jwt\s*=\s*false/,
  'braingg-api must disable gateway JWT verification because Telegram webhook uses its own secret');
assert.match(backend, /async function verifyTelegram\(/,
  'Telegram Mini App initData must be verified by the backend');
assert.match(backend, /TELEGRAM_WEBHOOK_SECRET/,
  'Telegram payment webhook must validate its dedicated secret');
assert.match(backend, /suppliedWebhookSecret && !webhookSecret[\s\S]*?return respond\(\{ error: "Webhook authentication is not configured" \}, 503\)/,
  'Telegram webhook must fail closed when its secret is missing');
assert.match(cases, /specialType:\s*"deposit"[\s\S]*?60 GG[\s\S]*?7 дней/,
  'BrainGG CASE must retain the 60 GG / rolling 7-day requirement');
assert.match(backend, /deposit:\s*7 \* 24 \* 60 \* 60 \* 1000/,
  'BrainGG CASE API cooldown must be seven days');
assert.match(backend, /cooldownOpenedAt \+ SPECIAL_CASE_COOLDOWN_MS\[specialCaseType\]/,
  'Successful special-case response must use the selected case cooldown');
assert.match(sql, /interval '7 days'/,
  'Database atomic claim must enforce the seven-day BrainGG CASE cooldown');
assert.match(sql, /enable row level security/i,
  'Special-case cooldown storage must have RLS enabled');
assert.match(sql, /grant execute on function public\.claim_special_case_cooldown\(bigint, text\) to service_role/i,
  'Only the service role should be able to claim special-case cooldowns');
assert.ok(existsSync(path.join(root, '.env.example')), 'Frontend environment example must exist');
assert.ok(packageJson.scripts?.build, 'Production build script must exist');
const appSource = read('src/App.jsx');
const entrySource = read('src/main.jsx');
assert.match(appSource, /Telegram's native Back button|Telegram\u2019s native Back button/,
  'Telegram native Back button integration must remain documented in source');
assert.match(entrySource, /class AppErrorBoundary extends React\.Component/,
  'The app must show a recovery screen instead of a blank page after a render crash');

assert.match(backend, /durationSeconds = body\.durationSeconds == null \? 179 : Number\(body\.durationSeconds\)/,
  'Global event duration must retain the legacy 179-second default when omitted');
assert.match(backend, /durationSeconds < 30 \|\| durationSeconds > 1800/,
  'Global event duration must be bounded on the server');
assert.match(backend, /currentEvent\?\.event_name === requestedEvent && !forceRestart/,
  'Owner must be able to restart the same active global event');
assert.match(appSource, /adminEventFavoritesOnly[\s\S]*?adminEventCompareA[\s\S]*?adminEventHistoryPeriod/,
  'Cross-device event command center must include favorites, comparison, and history filters');
assert.match(appSource, /admin-event-mobile-tools[\s\S]*?admin-event-history-mobile/,
  'Responsive event command center and event history must be present');
assert.match(appSource, /ADMIN CONSOLE · BUILD 3\.3/,
  'The cross-device admin release marker must be visible so deployment can be verified');
assert.match(appSource, /admin-mobile-player-search[\s\S]*?searchAdminPlayer\(event, true\)/,
  'The admin overview must include a working quick player search on all devices');
assert.match(appSource, /copyAdminControlSnapshot[\s\S]*?Сводка админ-панели/,
  'The admin overview must include a copyable control-center snapshot on all devices');
assert.match(appSource, /admin-events-readonly-mobile[\s\S]*?globalActivities\.filter/,
  'Non-owner admins must receive a read-only event monitor instead of an empty dead end');
assert.match(appSource, /admin-mobile-device/,
  'Admin tools must remain responsive when Telegram WebView reports a wider viewport');

assert.match(appSource, /adminSection === key \? "active" : ""/,
  'The tools tab must be part of the shared admin navigation');
const appCss = read('src/App.css');
assert.match(appCss, /@media \(min-width:\s*601px\)[\s\S]*?\.admin-tools-view\s*\{[^}]*display:\s*grid/s,
  'Desktop admin tools must be visible outside the mobile-only layout');
assert.match(appCss, /@media \(min-width:\s*601px\)[\s\S]*?\.admin-event-mobile-tools\s*\{[^}]*display:\s*grid/s,
  'Desktop event controls must be visible outside the mobile-only layout');
assert.match(appCss, /@media \(min-width:\s*601px\)[\s\S]*?\.admin-event-history-mobile\s*\{[^}]*display:\s*block/s,
  'Desktop event history must be visible outside the mobile-only layout');
assert.doesNotMatch(appSource, /restoreDesktopAdminDefaults/,
  'Desktop resizing must not reset the selected admin section or filters');

const assetCheck = spawnSync(process.execPath, [path.join(root, 'scripts/verify-assets')], {
  cwd: root,
  encoding: 'utf8',
});
if (assetCheck.status !== 0) {
  process.stderr.write(assetCheck.stdout || '');
  process.stderr.write(assetCheck.stderr || '');
  process.exit(assetCheck.status ?? 1);
}
process.stdout.write(assetCheck.stdout);
console.log('BrainGG: OK — API auth boundaries, payment webhook configuration, special-case cooldown contract, SQL permissions, and project assets checked.');

const minesSql = read('supabase/manual-sql/mines-mode.sql');
assert.match(appSource, /page === "Мины"/, 'Mines mode UI must be registered as a page');
assert.match(appSource, /mines_start_game/, 'Mines UI must start games through the trusted backend');
assert.match(appSource, /mines_reveal_cell/, 'Mines UI must reveal cells through the trusted backend');
assert.match(backend, /crypto\.getRandomValues\(new Uint32Array\(25\)\)/, 'Mine positions must be generated with cryptographically secure randomness');
assert.match(backend, /cashout_mines_game/, 'Mines cashout must be processed by the database');
assert.match(minesSql, /enable row level security/i, 'Mines game storage must have RLS enabled');
assert.match(minesSql, /mines_one_active_game_per_player/, 'A player may have only one active Mines round');
assert.match(minesSql, /for update/i, 'Mines balance and game updates must be transactionally locked');
assert.match(minesSql, /grant execute on function public\.cashout_mines_game\(bigint,uuid\) to service_role/i, 'Only service role may pay out Mines winnings');
console.log('BrainGG Mines: OK — server-side RNG, locked balance transactions, RLS, one active game, and trusted cashout checked.');

// v19 catalogue contract: prevent the anniversary/referral entries from being
// accidentally swapped and keep requested visible catalogue prices/assets.
assert.match(cases, /name: "Юбилейный кейс"[\s\S]*?price: 209[\s\S]*?category: "All In"/,
  'Anniversary case must remain a paid All In case at 209 GG');
assert.match(cases, /name: "CHEAP CASE"[\s\S]*?price: 9/,
  'CHEAP CASE must be listed at 9 GG');
assert.match(cases, /name: "Headless Horseman All-In"[\s\S]*?price: 59/,
  'Headless Horseman All-In must be listed at 59 GG');
assert.match(cases, /name: "Strawberry Elephant All-In"[\s\S]*?price: 39/,
  'Strawberry Elephant All-In must be listed at 39 GG');
assert.match(cases, /name: "DARK кейс"[\s\S]*?price: 99/,
  'DARK case must be listed at 99 GG');
assert.match(cases, /id: "referral-case", name: "Реферальный кейс"[\s\S]*?specialType: "deposit"/,
  'Referral case must remain the deposit-gated special case');
assert.match(appCss, /\.case-card-art\.case-artwork\s*\{[^}]*aspect-ratio:\s*1\s*\/\s*1/s,
  'Case artwork containers must be square');

// YETIMATIC shared boss event contract: server-only damage, one-time rewards,
// weekly lifecycle and both entry points (home banner + dedicated boss page).
const bossSql = read('supabase/manual-sql/yetimatic-boss-event.sql');
assert.match(bossSql, /max_hp integer not null default 5000/, 'YETIMATIC must start with 5,000 HP');
assert.match(bossSql, /ends_at timestamptz not null default \(now\(\) \+ interval '7 days'\)/, 'YETIMATIC must run for seven days');
assert.match(bossSql, /boss_claim_reward[\s\S]*?reward_claimed=true/, 'Boss rewards must be claimed only once');
assert.match(backend, /applyYetimaticDamage\(upgradeWon \? 20 : 5\)/, 'Upgrade outcomes must apply server-side boss damage');
assert.match(backend, /applyYetimaticDamage\(caseDamage\)/, 'Successful case opens must apply server-side boss damage');
assert.match(appSource, /yetimatic-home-banner[\s\S]*?changePage\("Боссы"\)/, 'Home page must link to the YETIMATIC event');
assert.match(appSource, /page === "Боссы"[\s\S]*?yetimatic-leaderboard/, 'Dedicated boss page must show the damage leaderboard');
console.log('BrainGG YETIMATIC: OK — shared 5,000 HP / 7-day boss, server-side damage, one-time rewards and UI entry points checked.');
